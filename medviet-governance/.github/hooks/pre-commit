#!/bin/bash
# Pre-commit hook: chạy security checks trước khi commit

echo "🔍 Running security checks..."

# 1. Check for common secrets patterns
echo "🔐 Scanning for secrets..."
SECRETS_PATTERNS=(
    "password\s*=\s*['\"][^'\"]+['\"]"
    "api[_-]?key\s*=\s*['\"][^'\"]+['\"]"
    "secret[_-]?key\s*=\s*['\"][^'\"]+['\"]"
    "aws[_-]?access[_-]?key"
    "private[_-]?key"
    "BEGIN RSA PRIVATE KEY"
    "BEGIN PRIVATE KEY"
    "token\s*=\s*['\"][^'\"]+['\"]"
)

for pattern in "${SECRETS_PATTERNS[@]}"; do
    if git diff --cached | grep -iE "$pattern"; then
        echo "❌ Potential secret found matching pattern: $pattern"
        echo "Please remove secrets before committing!"
        exit 1
    fi
done

# 2. Bandit SAST scan
if command -v bandit &> /dev/null; then
    echo "🐍 Running Bandit SAST..."
    bandit -r src/ -ll -q
    if [ $? -ne 0 ]; then
        echo "❌ Bandit found security issues! Review above."
        exit 1
    fi
else
    echo "⚠️  Bandit not installed, skipping SAST scan"
fi

# 3. pip-audit dependency check
if command -v pip-audit &> /dev/null; then
    echo "📦 Checking dependencies for CVEs..."
    pip-audit --desc on 2>/dev/null
    if [ $? -ne 0 ]; then
        echo "⚠️  Vulnerable dependencies found! Update before committing."
        exit 1
    fi
else
    echo "⚠️  pip-audit not installed, skipping dependency check"
fi

echo "✅ All security checks passed!"
exit 0
